# 复制本文件为 .env 并填入真实值：cp .env.example .env
# .env 已在 .gitignore 中，永远不会进 git

# 必填：DeepSeek API Key
DEEPSEEK_API_KEY=

# 可选：以下均有默认值，不配也能跑
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
DEEPSEEK_MAX_RETRIES=2

# 日志：LOG_LEVEL = DEBUG / INFO / WARNING / ERROR，LOG_FORMAT = text / json
LOG_LEVEL=INFO
LOG_FORMAT=text

# 系统提示词
SYSTEM_PROMPT=你是一个简洁、耐心的中文 AI 助手。
